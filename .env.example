# AI Interview Performance Analyzer - Environment Configuration

# Flask Secret Key
FLASK_SECRET_KEY=dev-secret-key-replace-in-production-2026

# Database Mode: 'sqlite' (local zero-config) or 'supabase' (PostgreSQL cloud)
DB_MODE=sqlite
SQLITE_DB_PATH=interview_analyzer.db

# Supabase Credentials (optional, needed when DB_MODE=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Used ONLY server-side for admin migrations
# SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# AI Provider Configuration (Google Gemini / OpenAI / Fallback)
# Supported: gemini, openai, rule_based
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Maximum Upload Size (16MB default)
MAX_CONTENT_LENGTH=16777216
